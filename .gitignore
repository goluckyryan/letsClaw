# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets — config.yaml holds the bot token
config.yaml

# Runtime state
state/
logs/
*.log

# Local test suite — kept out of the tree deliberately
tests/

# Per-session behavior files: named after whatever sessions this machine
# happens to have, and their contents go straight into a system prompt. The
# README explaining the directory is the one thing here worth committing.
models/sessions/*.md
!models/sessions/README.md

# Voice models/samples: 61 MB of binary next to a 5.3 MB repo, and regenerable.
# One `git add -A` would commit the lot and there is no taking it back out.
voices/

# Working note, by Ryan's instruction (2026-10-30): the README split plan stays
# on this machine. Named rather than `docs/*-plan.md` because the webcam plan is
# tracked, and a wildcard would quietly swallow the next plan that is meant to
# ship. It is referenced from docs/README.md as a path, not a link, so no gate
# can see it either way.
docs/readme-split-plan.md

# Editor / OS
.vscode/
.idea/
.DS_Store
